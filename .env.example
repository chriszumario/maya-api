# Required
APP_ENV=development
REDIS_URL=redis://localhost:6379
JWT_SECRET=
# 32 bytes aleatorios en base64url sin padding. Ejemplo: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
REFRESH_ROTATION_ENCRYPTION_KEY=
TURSO_DATABASE_URL=turso://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional server
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# Optional AI (required for /ai/*)
GROQ_API_KEY=

# Admin: el primer admin se asigna manualmente en la DB:
# UPDATE users SET isAdmin = 1, isActive = 1 WHERE email = 'tu@email.com';
