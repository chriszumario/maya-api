{
  "name": "maya-api",
  "version": "1.0.50",
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1 <1.5.0"
  },
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:db": "bun test tests/integration/db",
    "test:services": "bun --preload ./tests/setup.ts tests/services.ts",
    "test:build": "bun --preload ./tests/setup.ts tests/smoke-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests build.ts drizzle.config.ts server.js",
    "verify": "bun run typecheck && bun run lint && bun test && bun run db:check && bun run build && bun run test:build",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun run src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/jwt": "2.0.0-beta.1",
    "@logtape/logtape": "2.4.0-dev.881",
    "@tursodatabase/serverless": "^1.4.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "elysia": "2.0.0-beta.29",
    "groq-sdk": "^1.5.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxlint": "1.83.0"
  }
}
