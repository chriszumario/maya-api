    },
    {
      "value": "\n    \"plannedTasksCount\" >= 0 AND\n    \"plannedMinutes\" >= 0 AND\n    \"pendingTasksCount\" >= 0 AND\n    \"inProgressTasksCount\" >= 0 AND\n    \"completedTasksCount\" >= 0 AND\n    \"completedMinutes\" >= 0\n  ",
      "name": "daily_user_metrics_nonnegative_check",
      "entityType": "checks",
      "table": "daily_user_metrics"
    },
    {
      "value": "\n    \"plannedTasksCount\" = \"pendingTasksCount\" + \"inProgressTasksCount\" + \"completedTasksCount\"\n  ",
      "name": "daily_user_metrics_counts_check",
      "entityType": "checks",
      "table": "daily_user_metrics"
    },
    {
      "value": "\"category\" IN ('growth', 'experience', 'contribution')",
      "name": "goals_category_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"priority\" IN ('low', 'medium', 'high')",
      "name": "goals_priority_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"status\" IN ('pending', 'in_progress', 'completed', 'cancelled')",
      "name": "goals_status_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"status\" != 'completed' OR \"endedAt\" IS NOT NULL",
      "name": "goals_completed_endedAt_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"endedAt\" IS NULL OR \"status\" IN ('completed', 'cancelled')",
      "name": "goals_endedAt_status_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"startDate\" IS NULL OR \"endedAt\" IS NULL OR \"endedAt\" >= \"startDate\"",
      "name": "goals_lifecycle_dates_check",
      "entityType": "checks",
      "table": "goals"
    },
    {
      "value": "\"mood\" IN ('excellent', 'good', 'neutral', 'bad', 'terrible')",
      "name": "journal_entries_mood_check",
      "entityType": "checks",
      "table": "journal_entries"
    },
    {
      "value": "\"energyLevel\" BETWEEN 1 AND 5",
      "name": "journal_entries_energyLevel_check",
      "entityType": "checks",
      "table": "journal_entries"
    },
    {
      "value": "\"mealType\" IN ('breakfast', 'lunch', 'dinner', 'snack', 'drink')",
      "name": "nutrition_entries_mealType_check",
      "entityType": "checks",
      "table": "nutrition_entries"
    },
    {
      "value": "\"quantity\" > 0 AND \"quantity\" <= 1000000",
      "name": "nutrition_entries_quantity_check",
      "entityType": "checks",
      "table": "nutrition_entries"
    },
    {
      "value": "\"calories\" BETWEEN 0 AND 100000",
      "name": "nutrition_entries_calories_check",
      "entityType": "checks",
      "table": "nutrition_entries"
    },
    {
      "value": "\"status\" IN ('in_progress', 'completed')",
      "name": "task_logs_status_check",
      "entityType": "checks",
      "table": "task_logs"
    },
    {
      "value": "\"durationMinutes\" BETWEEN 0 AND 1440",
      "name": "task_logs_durationMinutes_check",
      "entityType": "checks",
      "table": "task_logs"
    },
    {
      "value": "\"frequency\" IN ('daily', 'weekly', 'monthly', 'once')",
      "name": "tasks_frequency_check",
      "entityType": "checks",
      "table": "tasks"
    },
    {
      "value": "\"estimatedMinutes\" BETWEEN 0 AND 1440",
      "name": "tasks_estimatedMinutes_check",
      "entityType": "checks",
      "table": "tasks"
    },
    {
      "value": "(\n          (\"frequency\" = 'daily' AND \"recurrenceMask\" = 0) OR\n          (\"frequency\" = 'weekly' AND \"recurrenceMask\" BETWEEN 1 AND 127) OR\n          (\"frequency\" = 'monthly' AND \"recurrenceMask\" BETWEEN 1 AND 31) OR\n          (\"frequency\" = 'once'\n            AND \"recurrenceMask\" BETWEEN 19000101 AND 20991231\n            AND strftime('%Y%m%d', printf('%04d-%02d-%02d',\n              \"recurrenceMask\" / 10000,\n              \"recurrenceMask\" / 100 % 100,\n              \"recurrenceMask\" % 100\n            )) IS printf('%08d', \"recurrenceMask\"))\n        )",
      "name": "tasks_recurrenceMask_check",
      "entityType": "checks",
      "table": "tasks"
    }
  ],
